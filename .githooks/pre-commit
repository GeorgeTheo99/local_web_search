#!/bin/sh
set -eu

repo=$(git rev-parse --show-toplevel)
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required (brew install gitleaks)" >&2
  exit 1
fi
if git diff --cached --quiet --no-ext-diff; then
  exit 0
fi
git diff --cached --binary --no-ext-diff | gitleaks stdin --no-banner --redact --config "$repo/.gitleaks.toml" --gitleaks-ignore-path "$repo/.gitleaksignore"
