#!/usr/bin/env bash
# local-search — operator CLI for the Brave-only local web-search broker.
#
# Usage:
#   local-search install [--no-start]   sync venv + plist + start + verify
#   local-search uninstall             stop service and remove plist
#   local-search start | stop | restart
#   local-search status                launchd state + /health probe
#   local-search stats [24h|7d|30d]    query-free aggregate telemetry
#   local-search telemetry-reset --yes explicitly erase telemetry events
#   local-search verify                health + tools/list smoke
#   local-search logs [mcp|tailnet] [lines]
#   local-search rotate-logs --yes     privately archive operational logs
#   local-search update                git pull + dependency sync + restart
#   local-search mcp-stdio             run MCP in stdio mode
#   local-search env                   print resolved non-secret config
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
MCP_DIR="$ROOT_DIR/mcp-websearch"
MCP_LABEL="com.local.mcp-websearch"
PLIST_DIR="$HOME/Library/LaunchAgents"
MCP_PLIST="$PLIST_DIR/$MCP_LABEL.plist"
TAILNET_LABEL="com.local.mcp-websearch-tailnet"
TAILNET_PLIST="$PLIST_DIR/$TAILNET_LABEL.plist"
INSTALL_CONFIG="${LOCAL_SEARCH_INSTALL_CONFIG:-$ROOT_DIR/data/install.env}"

installed_config_value() {
  local metadata
  [ -f "$INSTALL_CONFIG" ] && [ ! -L "$INSTALL_CONFIG" ] || return 0
  metadata="$(stat -f '%u %l %Lp' "$INSTALL_CONFIG" 2>/dev/null || stat -c '%u %h %a' "$INSTALL_CONFIG" 2>/dev/null || true)"
  [ "$metadata" = "$(id -u) 1 600" ] || return 0
  awk -v prefix="$1=" 'index($0, prefix) == 1 {print substr($0, length(prefix) + 1); exit}' \
    "$INSTALL_CONFIG"
}

installed_mcp_env() {
  [ -f "$MCP_PLIST" ] || return 0
  /usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:$1" "$MCP_PLIST" 2>/dev/null || true
}

MCP_PORT="${MCP_PORT:-$(installed_config_value MCP_PORT)}"
MCP_PORT="${MCP_PORT:-$(installed_mcp_env MCP_PORT)}"
MCP_PORT="${MCP_PORT:-8889}"
# An explicitly empty hostname disables remote ingress, even after installation.
MCP_TAILNET_HOST="${MCP_TAILNET_HOST-$(installed_config_value MCP_TAILNET_HOST)}"
MCP_TAILNET_PORT="${MCP_TAILNET_PORT:-$(installed_config_value MCP_TAILNET_PORT)}"
MCP_TAILNET_PORT="${MCP_TAILNET_PORT:-8891}"
WEBSEARCH_PROVIDER_STACK="brave"
WEBSEARCH_SEARCH_MODE="${WEBSEARCH_SEARCH_MODE:-$(installed_config_value WEBSEARCH_SEARCH_MODE)}"
WEBSEARCH_SEARCH_MODE="${WEBSEARCH_SEARCH_MODE:-$(installed_mcp_env WEBSEARCH_SEARCH_MODE)}"
WEBSEARCH_SEARCH_MODE="${WEBSEARCH_SEARCH_MODE:-normal}"
WEBSEARCH_TOTAL_TIMEOUT="${WEBSEARCH_TOTAL_TIMEOUT:-$(installed_config_value WEBSEARCH_TOTAL_TIMEOUT)}"
WEBSEARCH_TOTAL_TIMEOUT="${WEBSEARCH_TOTAL_TIMEOUT:-$(installed_mcp_env WEBSEARCH_TOTAL_TIMEOUT)}"
WEBSEARCH_TOTAL_TIMEOUT="${WEBSEARCH_TOTAL_TIMEOUT:-18}"
WEBSEARCH_BRAVE_TIMEOUT="${WEBSEARCH_BRAVE_TIMEOUT:-$(installed_config_value WEBSEARCH_BRAVE_TIMEOUT)}"
WEBSEARCH_BRAVE_TIMEOUT="${WEBSEARCH_BRAVE_TIMEOUT:-$(installed_mcp_env WEBSEARCH_BRAVE_TIMEOUT)}"
WEBSEARCH_BRAVE_TIMEOUT="${WEBSEARCH_BRAVE_TIMEOUT:-8}"
LOCAL_SEARCH_TELEMETRY_ENABLED="${LOCAL_SEARCH_TELEMETRY_ENABLED:-$(installed_config_value LOCAL_SEARCH_TELEMETRY_ENABLED)}"
LOCAL_SEARCH_TELEMETRY_ENABLED="${LOCAL_SEARCH_TELEMETRY_ENABLED:-$(installed_mcp_env LOCAL_SEARCH_TELEMETRY_ENABLED)}"
LOCAL_SEARCH_TELEMETRY_ENABLED="${LOCAL_SEARCH_TELEMETRY_ENABLED:-true}"
DECODO_FALLBACK_ENABLED="${DECODO_FALLBACK_ENABLED:-$(installed_config_value DECODO_FALLBACK_ENABLED)}"
DECODO_FALLBACK_ENABLED="${DECODO_FALLBACK_ENABLED:-$(installed_mcp_env DECODO_FALLBACK_ENABLED)}"
DECODO_FALLBACK_ENABLED="${DECODO_FALLBACK_ENABLED:-true}"
DECODO_TIMEOUT="${DECODO_TIMEOUT:-$(installed_config_value DECODO_TIMEOUT)}"
DECODO_TIMEOUT="${DECODO_TIMEOUT:-$(installed_mcp_env DECODO_TIMEOUT)}"
DECODO_TIMEOUT="${DECODO_TIMEOUT:-30}"
DECODO_RESPONSE_MAX_BYTES="${DECODO_RESPONSE_MAX_BYTES:-$(installed_config_value DECODO_RESPONSE_MAX_BYTES)}"
DECODO_RESPONSE_MAX_BYTES="${DECODO_RESPONSE_MAX_BYTES:-$(installed_mcp_env DECODO_RESPONSE_MAX_BYTES)}"
DECODO_RESPONSE_MAX_BYTES="${DECODO_RESPONSE_MAX_BYTES:-5242880}"
WEBSEARCH_FETCH_OPERATION_TIMEOUT="${WEBSEARCH_FETCH_OPERATION_TIMEOUT:-$(installed_config_value WEBSEARCH_FETCH_OPERATION_TIMEOUT)}"
WEBSEARCH_FETCH_OPERATION_TIMEOUT="${WEBSEARCH_FETCH_OPERATION_TIMEOUT:-$(installed_mcp_env WEBSEARCH_FETCH_OPERATION_TIMEOUT)}"
WEBSEARCH_FETCH_OPERATION_TIMEOUT="${WEBSEARCH_FETCH_OPERATION_TIMEOUT:-60}"

LOG_DIR="${LOCAL_SEARCH_LOG_DIR:-$HOME/Library/Logs/local-search}"
LOCAL_SEARCH_DATA_DIR_EXPLICIT=0
[ -n "${LOCAL_SEARCH_DATA_DIR:-}" ] && LOCAL_SEARCH_DATA_DIR_EXPLICIT=1
LOCAL_SEARCH_DATA_DIR="${LOCAL_SEARCH_DATA_DIR:-$(installed_config_value LOCAL_SEARCH_DATA_DIR)}"
LOCAL_SEARCH_DATA_DIR="${LOCAL_SEARCH_DATA_DIR:-$(installed_mcp_env LOCAL_SEARCH_DATA_DIR)}"
LOCAL_SEARCH_DATA_DIR="${LOCAL_SEARCH_DATA_DIR:-$ROOT_DIR/data}"
case "$LOCAL_SEARCH_DATA_DIR" in
  /*) ;;
  *) LOCAL_SEARCH_DATA_DIR="$ROOT_DIR/$LOCAL_SEARCH_DATA_DIR" ;;
esac
LEGACY_REPO_DATA_DIR="${ROOT_DIR%/*}/local-search/data"
legacy_root="${LEGACY_REPO_DATA_DIR%/data}"
if [ "$LOCAL_SEARCH_DATA_DIR_EXPLICIT" -eq 0 ] \
  && [ "$LOCAL_SEARCH_DATA_DIR" = "$LEGACY_REPO_DATA_DIR" ] \
  && [ ! -e "$legacy_root/.git" ]; then
  printf '! migrating stale repository-local data path to %s/data\n' "$ROOT_DIR" >&2
  LOCAL_SEARCH_DATA_DIR="$ROOT_DIR/data"
fi

normalize_bool() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | xargs)" in
    0|false|no|off) printf false ;;
    *) printf true ;;
  esac
}
LOCAL_SEARCH_TELEMETRY_ENABLED="$(normalize_bool "$LOCAL_SEARCH_TELEMETRY_ENABLED")"
DECODO_FALLBACK_ENABLED="$(normalize_bool "$DECODO_FALLBACK_ENABLED")"
DECODO_SECRET_FILE="$LOCAL_SEARCH_DATA_DIR/decodo_key"
MCP_VENV="$MCP_DIR/.venv"

if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'
else
  C_RESET=""; C_BOLD=""; C_GREEN=""; C_YELLOW=""; C_RED=""
fi
log()  { printf '%s▶%s %s\n' "$C_BOLD" "$C_RESET" "$*"; }
ok()   { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
require_cmd() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

validate_search_configuration() {
  case "$WEBSEARCH_SEARCH_MODE" in
    normal|sensitive|maximum_recall) ;;
    *) die "WEBSEARCH_SEARCH_MODE must be normal, sensitive, or maximum_recall" ;;
  esac
  case "$MCP_PORT" in
    ''|*[!0-9]*) die "MCP_PORT must contain only ASCII digits" ;;
  esac
  python3 - "$WEBSEARCH_TOTAL_TIMEOUT" "$WEBSEARCH_BRAVE_TIMEOUT" \
    "$DECODO_TIMEOUT" "$DECODO_RESPONSE_MAX_BYTES" \
    "$WEBSEARCH_FETCH_OPERATION_TIMEOUT" "$MCP_PORT" \
    "$MCP_TAILNET_HOST" "$MCP_TAILNET_PORT" <<'PY' || exit 1
import re
import sys
try:
    total = float(sys.argv[1])
    brave = float(sys.argv[2])
    decodo = float(sys.argv[3])
    max_bytes = int(sys.argv[4])
    operation = float(sys.argv[5])
    mcp_port = int(sys.argv[6])
except ValueError:
    raise SystemExit("timeouts and MCP_PORT must be numeric and DECODO_RESPONSE_MAX_BYTES must be an integer")
if not 1 <= total <= 18:
    raise SystemExit("WEBSEARCH_TOTAL_TIMEOUT must be between 1 and 18")
if not 0.25 <= brave <= total:
    raise SystemExit("WEBSEARCH_BRAVE_TIMEOUT must be between 0.25 and WEBSEARCH_TOTAL_TIMEOUT")
if not 1 <= decodo <= 60:
    raise SystemExit("DECODO_TIMEOUT must be between 1 and 60")
if not 4096 <= max_bytes <= 20 * 1024 * 1024:
    raise SystemExit("DECODO_RESPONSE_MAX_BYTES must be between 4096 and 20971520")
if not 1 <= operation <= 120:
    raise SystemExit("WEBSEARCH_FETCH_OPERATION_TIMEOUT must be between 1 and 120")
if not 1 <= mcp_port <= 65535:
    raise SystemExit("MCP_PORT must be between 1 and 65535")
host, port = sys.argv[7:9]
label = r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?"
if host and (len(host) > 253 or not re.fullmatch(rf"{label}\.{label}\.ts\.net", host)):
    raise SystemExit("MCP_TAILNET_HOST must be a lowercase device.tailnet.ts.net hostname")
if not re.fullmatch(r"[0-9]{1,5}", port) or not 1 <= int(port) <= 65535:
    raise SystemExit("MCP_TAILNET_PORT must be an ASCII integer between 1 and 65535")
if host and int(port) == mcp_port:
    raise SystemExit("MCP_TAILNET_PORT must differ from MCP_PORT")
PY
}

ensure_data_dir() {
  mkdir -p "$LOCAL_SEARCH_DATA_DIR" "$LOCAL_SEARCH_DATA_DIR/cache"
  chmod 700 "$LOCAL_SEARCH_DATA_DIR" "$LOCAL_SEARCH_DATA_DIR/cache"
}

persist_install_config() {
  validate_search_configuration
  ensure_data_dir
  local config_dir metadata tmp
  config_dir="$(dirname "$INSTALL_CONFIG")"
  [ ! -L "$config_dir" ] || die "refusing symlinked install-config directory: $config_dir"
  mkdir -p "$config_dir"
  [ -d "$config_dir" ] && [ ! -L "$config_dir" ] || die "install-config parent is not a safe directory: $config_dir"
  metadata="$(stat -f '%u' "$config_dir" 2>/dev/null || stat -c '%u' "$config_dir")"
  [ "$metadata" = "$(id -u)" ] || die "install-config directory is not owned by this user: $config_dir"
  chmod 700 "$config_dir"
  if [ -e "$INSTALL_CONFIG" ] || [ -L "$INSTALL_CONFIG" ]; then
    [ -f "$INSTALL_CONFIG" ] && [ ! -L "$INSTALL_CONFIG" ] \
      || die "refusing unsafe install config: $INSTALL_CONFIG"
    metadata="$(stat -f '%u %l' "$INSTALL_CONFIG" 2>/dev/null || stat -c '%u %h' "$INSTALL_CONFIG")"
    [ "$metadata" = "$(id -u) 1" ] \
      || die "install config has unsafe ownership or hard links: $INSTALL_CONFIG"
  fi
  tmp="$(mktemp "$config_dir/.install.env.XXXXXX")"
  chmod 600 "$tmp"
  (umask 077; printf '%s\n' \
    "MCP_PORT=$MCP_PORT" \
    "MCP_TAILNET_HOST=$MCP_TAILNET_HOST" \
    "MCP_TAILNET_PORT=$MCP_TAILNET_PORT" \
    "LOCAL_SEARCH_DATA_DIR=$LOCAL_SEARCH_DATA_DIR" \
    "LOCAL_SEARCH_TELEMETRY_ENABLED=$LOCAL_SEARCH_TELEMETRY_ENABLED" \
    "WEBSEARCH_PROVIDER_STACK=brave" \
    "WEBSEARCH_SEARCH_MODE=$WEBSEARCH_SEARCH_MODE" \
    "WEBSEARCH_TOTAL_TIMEOUT=$WEBSEARCH_TOTAL_TIMEOUT" \
    "WEBSEARCH_BRAVE_TIMEOUT=$WEBSEARCH_BRAVE_TIMEOUT" \
    "DECODO_FALLBACK_ENABLED=$DECODO_FALLBACK_ENABLED" \
    "DECODO_TIMEOUT=$DECODO_TIMEOUT" \
    "DECODO_RESPONSE_MAX_BYTES=$DECODO_RESPONSE_MAX_BYTES" \
    "WEBSEARCH_FETCH_OPERATION_TIMEOUT=$WEBSEARCH_FETCH_OPERATION_TIMEOUT" \
    >"$tmp")
  mv -f "$tmp" "$INSTALL_CONFIG"
  chmod 600 "$INSTALL_CONFIG"
}

telemetry_enabled() { [ "$LOCAL_SEARCH_TELEMETRY_ENABLED" = "true" ]; }

check_prereqs() {
  require_cmd curl
  require_cmd git
  require_cmd launchctl
  require_cmd lsof
  require_cmd python3
  require_cmd uv
}

check_provider_credentials() {
  validate_search_configuration
  local brave_key="$LOCAL_SEARCH_DATA_DIR/brave_key"
  python3 - "$brave_key" "$DECODO_SECRET_FILE" <<'PY' || exit 1
import stat
import sys
from pathlib import Path

brave, decodo = map(Path, sys.argv[1:])
def token(path: Path, *, required: bool) -> bool:
    if not path.exists():
        return not required
    try:
        info = path.lstat()
        value = path.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError):
        return False
    return (
        stat.S_ISREG(info.st_mode)
        and info.st_mode & 0o077 == 0
        and bool(value)
        and all(33 <= ord(char) <= 126 and not char.isspace() for char in value)
    )
if not token(brave, required=True):
    print(f"Brave stack requires an owner-only nonempty key at {brave} (mode 600)", file=sys.stderr)
    raise SystemExit(1)
if not token(decodo, required=False):
    print(f"Decodo key must be a regular, owner-only, single-token file at {decodo} (mode 600)", file=sys.stderr)
    raise SystemExit(1)
PY
}

ensure_mcp_venv() {
  log "Synchronizing MCP websearch environment"
  uv sync --project "$MCP_DIR" >/dev/null
  [ -x "$MCP_VENV/bin/python" ] || die "MCP venv was not created"
  ok "MCP venv ready"
}

write_plist() {
  local label="${1:-$MCP_LABEL}" plist="${2:-}" target tmp
  target="$PLIST_DIR/$label.plist"
  mkdir -p "$PLIST_DIR"
  tmp="$(mktemp "$PLIST_DIR/.${label}.XXXXXX")"
  if [ -n "$plist" ]; then
    (umask 077; printf '%s' "$plist" >"$tmp")
  else
    (umask 077; mcp_plist >"$tmp")
  fi
  chmod 600 "$tmp"
  /usr/bin/plutil -lint "$tmp" >/dev/null || { rm -f "$tmp"; die "invalid plist for $label"; }
  mv -f "$tmp" "$target"
  chmod 600 "$target"
  ok "Wrote $target"
}

mcp_plist() {
  validate_search_configuration
  local label="$MCP_LABEL" port="$MCP_PORT" extra_arg="" log_name="mcp-websearch" tailnet_env=""
  if [ "${1:-}" = "tailnet" ]; then
    [ -n "$MCP_TAILNET_HOST" ] || die "MCP_TAILNET_HOST is required for tailnet ingress"
    label="$TAILNET_LABEL"; port="$MCP_TAILNET_PORT"
    extra_arg='<string>--tailnet</string>'; log_name="mcp-websearch-tailnet"
    tailnet_env="<key>MCP_TAILNET_HOST</key><string>${MCP_TAILNET_HOST}</string>"
  fi
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>${label}</string>
<key>ProgramArguments</key><array>
  <string>${MCP_VENV}/bin/python</string><string>${MCP_DIR}/http_server.py</string>${extra_arg}
</array>
<key>WorkingDirectory</key><string>${MCP_DIR}</string>
<key>EnvironmentVariables</key><dict>
  <key>MCP_PORT</key><string>${port}</string>
  ${tailnet_env}
  <key>WEBSEARCH_PROVIDER_STACK</key><string>brave</string>
  <key>WEBSEARCH_SEARCH_MODE</key><string>${WEBSEARCH_SEARCH_MODE}</string>
  <key>WEBSEARCH_TOTAL_TIMEOUT</key><string>${WEBSEARCH_TOTAL_TIMEOUT}</string>
  <key>WEBSEARCH_BRAVE_TIMEOUT</key><string>${WEBSEARCH_BRAVE_TIMEOUT}</string>
  <key>LOCAL_SEARCH_DATA_DIR</key><string>${LOCAL_SEARCH_DATA_DIR}</string>
  <key>LOCAL_SEARCH_TELEMETRY_ENABLED</key><string>${LOCAL_SEARCH_TELEMETRY_ENABLED}</string>
  <key>DECODO_FALLBACK_ENABLED</key><string>${DECODO_FALLBACK_ENABLED}</string>
  <key>DECODO_TIMEOUT</key><string>${DECODO_TIMEOUT}</string>
  <key>DECODO_RESPONSE_MAX_BYTES</key><string>${DECODO_RESPONSE_MAX_BYTES}</string>
  <key>WEBSEARCH_FETCH_OPERATION_TIMEOUT</key><string>${WEBSEARCH_FETCH_OPERATION_TIMEOUT}</string>
  <key>FASTMCP_SHOW_SERVER_BANNER</key><string>false</string>
</dict>
<key>StandardOutPath</key><string>${LOG_DIR}/${log_name}.log</string>
<key>StandardErrorPath</key><string>${LOG_DIR}/${log_name}.log</string>
<key>KeepAlive</key><true/>
<key>RunAtLoad</key><true/>
<key>ThrottleInterval</key><integer>5</integer>
<key>Umask</key><integer>63</integer>
</dict></plist>
EOF
}

ensure_private_logs() {
  mkdir -p "$LOG_DIR"
  chmod 700 "$LOG_DIR"
  (umask 077; touch "$LOG_DIR/mcp-websearch.log" "$LOG_DIR/mcp-websearch-tailnet.log")
  chmod 600 "$LOG_DIR/mcp-websearch.log" "$LOG_DIR/mcp-websearch-tailnet.log"
}

install_plist() {
  ensure_private_logs
  ensure_data_dir
  validate_search_configuration
  local plist preflight
  plist="$(mcp_plist)"
  preflight="$(mktemp "${TMPDIR:-/tmp}/local-search.plist.XXXXXX")"
  chmod 600 "$preflight"
  printf '%s' "$plist" >"$preflight"
  if ! /usr/bin/plutil -lint "$preflight" >/dev/null; then
    rm -f "$preflight"
    die "generated LaunchAgent plist is invalid"
  fi
  rm -f "$preflight"
  persist_install_config
  write_plist "$MCP_LABEL" "$plist"
  if [ -n "$MCP_TAILNET_HOST" ]; then
    write_plist "$TAILNET_LABEL" "$(mcp_plist tailnet)"
  else
    stop_tailnet_service
    rm -f "$TAILNET_PLIST"
  fi
}

retire_legacy_searxng() {
  launchctl bootout "gui/$(id -u)/com.local.searxng" >/dev/null 2>&1 || true
  rm -f "$PLIST_DIR/com.local.searxng.plist"
}

wait_tailnet_port_free() {
  if [ -f "$TAILNET_PLIST" ]; then
    local port
    port="$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:MCP_PORT' "$TAILNET_PLIST")" \
      || die "cannot verify tailnet listener shutdown; plist retained"
    _wait_port_free "$port"
  fi
}

stop_tailnet_service() {
  local target="gui/$(id -u)/$TAILNET_LABEL" state attempt
  if state="$(launchctl print "$target" 2>&1)"; then
    launchctl bootout "$target" >/dev/null 2>&1 \
      || die "could not stop tailnet ingress; plist retained"
    for attempt in 1 2 3 4 5; do
      if state="$(launchctl print "$target" 2>&1)"; then
        sleep 1
      else
        case "$state" in
          *"Could not find service"*)
            wait_tailnet_port_free
            return 0 ;;
          *) die "cannot verify tailnet service state; plist retained" ;;
        esac
      fi
    done
    die "tailnet ingress is still registered; plist retained"
  else
    case "$state" in
      *"Could not find service"*) wait_tailnet_port_free; return 0 ;;
      *) die "cannot establish tailnet service state; plist retained" ;;
    esac
  fi
}

bootout_service() {
  stop_tailnet_service
  launchctl bootout "gui/$(id -u)/$MCP_LABEL" >/dev/null 2>&1 || true
}

bootstrap_service() {
  local label="${1:-$MCP_LABEL}" plist="${2:-$MCP_PLIST}"
  local target="gui/$(id -u)/$label" attempt
  [ -f "$plist" ] || die "missing $plist; run install first"
  launchctl enable "$target" 2>/dev/null || true
  if launchctl print "$target" >/dev/null 2>&1; then
    launchctl kickstart -k "$target" >/dev/null 2>&1 && return
    launchctl bootout "$target" >/dev/null 2>&1 || true
    sleep 1
  fi
  for attempt in 1 2 3; do
    launchctl bootstrap "gui/$(id -u)" "$plist" >/dev/null 2>&1 && return
    sleep 1
  done
  die "could not bootstrap $label"
}

bootstrap_services() {
  bootstrap_service
  if [ -f "$TAILNET_PLIST" ]; then
    bootstrap_service "$TAILNET_LABEL" "$TAILNET_PLIST"
  fi
}

wait_ports_free() {
  _wait_port_free "$MCP_PORT"
  if [ -f "$TAILNET_PLIST" ]; then
    local port
    port="$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:MCP_PORT' "$TAILNET_PLIST")"
    _wait_port_free "$port"
  fi
}

_wait_port_free() {
  local port="$1" timeout="${2:-15}" i=0
  while [ "$i" -lt "$timeout" ]; do
    lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 || return 0
    sleep 1; i=$((i+1))
  done
  die "port $port still bound after ${timeout}s"
}

start_services() {
  check_provider_credentials
  bootstrap_services
}

stop_services() { bootout_service; }

restart_services() {
  check_provider_credentials
  stop_services
  wait_ports_free
  bootstrap_services
  wait_http "http://127.0.0.1:${MCP_PORT}/live" '"status":"ok"' 30
}

wait_http() {
  local url="$1" want="$2" timeout="${3:-20}" i=0 body
  while [ "$i" -lt "$timeout" ]; do
    body="$(curl -fsS --max-time 3 "$url" 2>/dev/null || true)"
    if [ -n "$body" ] && printf '%s' "$body" | grep -q "$want"; then
      ok "$url → $want"
      return 0
    fi
    sleep 1; i=$((i+1))
  done
  warn "timeout waiting for $url (wanted '$want')"
  return 1
}

verify() {
  local rc=0 tools
  wait_http "http://127.0.0.1:${MCP_PORT}/live" '"status":"ok"' 30 || rc=1
  wait_http "http://127.0.0.1:${MCP_PORT}/ready" '"ready":true' 30 || rc=1
  if telemetry_enabled; then
    wait_http "http://127.0.0.1:${MCP_PORT}/stats?window=24h" '"available":true' 30 || rc=1
  fi
  log "MCP tools/list"
  tools="$(curl -fsS --max-time 5 -X POST "http://127.0.0.1:${MCP_PORT}/mcp" \
    -H 'content-type: application/json' -H 'accept: application/json' \
    -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' 2>/dev/null \
    | python3 -c 'import sys,json;d=json.load(sys.stdin);print(",".join(sorted(t["name"] for t in d.get("result",{}).get("tools",[]))))' 2>/dev/null || true)"
  if [ "$tools" = "batch_web_search,image_search,verify_url,web_fetch,web_search" ]; then
    ok "MCP tools: $tools"
  else
    warn "MCP tools/list unexpected: '$tools'"
    rc=1
  fi
  if [ -n "$MCP_TAILNET_HOST" ]; then
    log "Tailnet ingress tools/list (local backend check; not a TLS/network test)"
    if curl -fsS --max-time 5 --retry 10 --retry-connrefused --retry-delay 1 --retry-max-time 20 \
      "http://127.0.0.1:${MCP_TAILNET_PORT}/mcp" \
      -H "Host: $MCP_TAILNET_HOST" \
      -H 'Content-Type: application/json' -H 'Accept: application/json' \
      -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
      | python3 -c 'import json,sys; d=json.load(sys.stdin); names={t["name"] for t in d["result"]["tools"]}; sys.exit(not {"web_search","web_fetch"} <= names)'; then
      ok "MCP-only tailnet ingress ready"
    else
      warn "tailnet ingress unavailable"
      rc=1
    fi
  fi
  return "$rc"
}

status() {
  local state health
  if [ -f "$TAILNET_PLIST" ]; then
    state="$(launchctl print "gui/$(id -u)/$TAILNET_LABEL" 2>/dev/null | awk -F' = ' '/^[[:space:]]*state/ {print $2; exit}' || echo 'not-loaded')"
    printf '%-22s %s\n' "tailnet ingress:" "${state:-unknown} (MCP-only; Serve managed separately)"
  fi
  state="$(launchctl print "gui/$(id -u)/$MCP_LABEL" 2>/dev/null | awk -F' = ' '/^[[:space:]]*state/ {print $2; exit}' || echo 'not-loaded')"
  printf '%-22s %s\n' "mcp-websearch launchd:" "${state:-unknown}"
  health="$(curl -fsS --max-time 3 "http://127.0.0.1:${MCP_PORT}/health" 2>/dev/null || echo 'DOWN')"
  printf '%-22s %s\n' "mcp /health:" "$(printf '%s' "$health" | python3 -c 'import sys,json;d=json.load(sys.stdin);t=d.get("telemetry") or {};f=(d.get("policy") or {}).get("fetch_fallbacks") or {};dc=f.get("decodo") or {};print(d.get("status","?"),"ready="+str(d.get("ready","?")),"stack="+str(d.get("provider_stack","?")),"telemetry="+str(t.get("available","?")),"decodo="+str(dc.get("credential_configured","?")))' 2>/dev/null || echo "$health")"
}

cmd_install() {
  local start=1
  [ "${1:-}" = "--no-start" ] && start=0
  check_prereqs
  validate_search_configuration
  [ "$start" -eq 0 ] || check_provider_credentials
  log "Installing local-search into $ROOT_DIR"
  ensure_mcp_venv
  install_plist
  if [ "$start" -eq 1 ]; then
    stop_services
    wait_ports_free
    start_services
    verify || die "verification failed; check 'local-search logs mcp'"
    retire_legacy_searxng
  fi
  ok "local-search installed"
}

cmd_uninstall() {
  stop_services
  rm -f "$MCP_PLIST" "$TAILNET_PLIST"
  retire_legacy_searxng
  ok "Uninstalled (venv, telemetry, cache, and keys retained)"
}

cmd_update_after_pull() {
  check_prereqs
  check_provider_credentials
  ensure_mcp_venv
  install_plist
  restart_services
  verify || die "verification failed after update"
  retire_legacy_searxng
  ok "local-search updated"
}

cmd_update() {
  check_prereqs
  check_provider_credentials
  git -C "$ROOT_DIR" pull --ff-only
  exec "$ROOT_DIR/scripts/local-search" _update-after-pull
}

cmd_env() {
  cat <<EOF
ROOT_DIR=$ROOT_DIR
MCP_DIR=$MCP_DIR
MCP_VENV=$MCP_VENV
MCP_PORT=$MCP_PORT
MCP_TAILNET_HOST=$MCP_TAILNET_HOST
MCP_TAILNET_PORT=$MCP_TAILNET_PORT
MCP_LABEL=$MCP_LABEL
INSTALL_CONFIG=$INSTALL_CONFIG
WEBSEARCH_PROVIDER_STACK=brave
WEBSEARCH_SEARCH_MODE=$WEBSEARCH_SEARCH_MODE
WEBSEARCH_TOTAL_TIMEOUT=$WEBSEARCH_TOTAL_TIMEOUT
WEBSEARCH_BRAVE_TIMEOUT=$WEBSEARCH_BRAVE_TIMEOUT
LOCAL_SEARCH_DATA_DIR=$LOCAL_SEARCH_DATA_DIR
LOCAL_SEARCH_TELEMETRY_ENABLED=$LOCAL_SEARCH_TELEMETRY_ENABLED
DECODO_FALLBACK_ENABLED=$DECODO_FALLBACK_ENABLED
DECODO_TIMEOUT=$DECODO_TIMEOUT
DECODO_RESPONSE_MAX_BYTES=$DECODO_RESPONSE_MAX_BYTES
WEBSEARCH_FETCH_OPERATION_TIMEOUT=$WEBSEARCH_FETCH_OPERATION_TIMEOUT
DECODO_SECRET_FILE=$DECODO_SECRET_FILE
LOG_DIR=$LOG_DIR
EOF
}

cmd_stats() {
  local window="${1:-24h}"
  case "$window" in 24h|7d|30d) ;; *) die "usage: local-search stats [24h|7d|30d]" ;; esac
  curl -fsS --max-time 10 "http://127.0.0.1:${MCP_PORT}/stats?window=${window}" \
    | python3 -m json.tool
}

cmd_telemetry_reset() {
  [ "${1:-}" = "--yes" ] || die "usage: local-search telemetry-reset --yes"
  [ -x "$MCP_VENV/bin/python" ] || die "MCP venv missing; run install first"
  ensure_data_dir
  local was_loaded=0 tailnet_loaded=0 rc=0
  launchctl print "gui/$(id -u)/$MCP_LABEL" >/dev/null 2>&1 && was_loaded=1
  launchctl print "gui/$(id -u)/$TAILNET_LABEL" >/dev/null 2>&1 && tailnet_loaded=1
  bootout_service
  wait_ports_free
  "$MCP_VENV/bin/python" "$MCP_DIR/telemetry.py" reset \
    --data-dir "$LOCAL_SEARCH_DATA_DIR" || rc=$?
  if [ "$was_loaded" -eq 1 ]; then
    bootstrap_service
    wait_http "http://127.0.0.1:${MCP_PORT}/live" '"status":"ok"' 30 || rc=1
  fi
  if [ "$tailnet_loaded" -eq 1 ]; then
    bootstrap_service "$TAILNET_LABEL" "$TAILNET_PLIST"
  fi
  return "$rc"
}

cmd_logs() {
  local which="${1:-mcp}" lines="${2:--50}"
  ensure_private_logs
  case "$which" in
    mcp|mcp-websearch|all|"") tail "$lines" "$LOG_DIR/mcp-websearch.log" 2>/dev/null || warn "no mcp log yet" ;;
    tailnet) tail "$lines" "$LOG_DIR/mcp-websearch-tailnet.log" 2>/dev/null || warn "no tailnet log yet" ;;
    *) die "usage: local-search logs [mcp|tailnet] [lines]" ;;
  esac
}

cmd_rotate_logs() {
  [ "${1:-}" = "--yes" ] || die "usage: local-search rotate-logs --yes"
  local loaded=0 tailnet_loaded=0 stamp archive target archived n=0 rc=0 name
  launchctl print "gui/$(id -u)/$MCP_LABEL" >/dev/null 2>&1 && loaded=1
  launchctl print "gui/$(id -u)/$TAILNET_LABEL" >/dev/null 2>&1 && tailnet_loaded=1
  stop_services
  wait_ports_free
  ensure_private_logs
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  archive="$LOG_DIR/archive"
  mkdir -p "$archive"; chmod 700 "$archive"
  for name in mcp-websearch mcp-websearch-tailnet; do
    target="$LOG_DIR/$name.log"
    if [ -s "$target" ]; then
      archived="$archive/${name}.${stamp}.log"
      while [ -e "$archived" ]; do n=$((n+1)); archived="$archive/${name}.${stamp}.${n}.log"; done
      mv "$target" "$archived"; chmod 600 "$archived"
      ok "Archived without deleting: $archived"
    fi
    (umask 077; : >"$target"); chmod 600 "$target"
  done
  if [ "$loaded" -eq 1 ]; then
    bootstrap_service || rc=1
    wait_http "http://127.0.0.1:${MCP_PORT}/live" '"status":"ok"' 30 || rc=1
  fi
  if [ "$tailnet_loaded" -eq 1 ]; then
    bootstrap_service "$TAILNET_LABEL" "$TAILNET_PLIST" || rc=1
  fi
  return "$rc"
}

cmd_mcp_stdio() {
  validate_search_configuration
  export LOCAL_SEARCH_DATA_DIR LOCAL_SEARCH_TELEMETRY_ENABLED
  export WEBSEARCH_PROVIDER_STACK WEBSEARCH_SEARCH_MODE WEBSEARCH_TOTAL_TIMEOUT
  export WEBSEARCH_BRAVE_TIMEOUT
  export DECODO_FALLBACK_ENABLED DECODO_TIMEOUT DECODO_RESPONSE_MAX_BYTES
  export WEBSEARCH_FETCH_OPERATION_TIMEOUT
  exec "$MCP_VENV/bin/python" "$MCP_DIR/server.py"
}

usage() {
  sed -n '2,/^set -euo/p' "$0" | grep -E '^#   ' | sed 's/^#   /  /'
  exit 1
}

main() {
  [ "$#" -ge 1 ] || usage
  case "$1" in
    install|bootstrap) shift; cmd_install "$@" ;;
    uninstall) cmd_uninstall ;;
    start) check_prereqs; start_services; ok "started" ;;
    stop) stop_services; ok "stopped" ;;
    restart) check_prereqs; restart_services; ok "restarted" ;;
    status) status ;;
    stats) shift; cmd_stats "$@" ;;
    telemetry-reset) shift; cmd_telemetry_reset "$@" ;;
    verify) verify ;;
    logs) shift; cmd_logs "$@" ;;
    rotate-logs) shift; cmd_rotate_logs "$@" ;;
    update) cmd_update ;;
    _update-after-pull) cmd_update_after_pull ;;
    mcp-stdio) cmd_mcp_stdio ;;
    env) cmd_env ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $1" ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
