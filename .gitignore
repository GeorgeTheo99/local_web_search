# Python/runtime
__pycache__/
*.py[cod]
.venv/

# Vendored SearXNG checkout/runtime (bootstrapped by scripts/local-search)
searxng/src/

# Operator logs
.logs/

# Private query-free telemetry (including SQLite WAL/SHM files) and local install state
data/*.sqlite3*
data/cache/
data/install.env

# Provider API keys (mode-0600 secret files, never committed)
data/*_key
data/brave_key
data/kagi_key
data/perplexity_key

# pytest
.pytest_cache/

# uv lock is tracked for reproducible installs
!uv.lock
